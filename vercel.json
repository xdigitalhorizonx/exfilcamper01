{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/singleplayergames", "destination": "/singleplayergames/index.html" },
    { "source": "/singleplayergames/video", "destination": "/singleplayergames/video/index.html" },
    { "source": "/hermedicretake/video", "destination": "/hermedicretake/video/index.html" }
  ],
  "redirects": [
    { "source": "/hermedicretake", "destination": "/hermedicretake/video", "permanent": true },
    { "source": "/hermedicretake/", "destination": "/hermedicretake/video", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(fonts|video|img)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(css|js|data)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] }
  ]
}
